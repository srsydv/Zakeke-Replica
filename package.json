{
  "name": "bluecotton",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "next dev --port 3000",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build",
    "start": "concurrently -k -n api,web -c cyan,magenta \"npm run start:api\" \"npm run start:web\"",
    "start:web": "next start --port 3000",
    "start:api": "tsx server/index.ts",
    "catalog": "python3 scripts/build-catalog.py && npm run catalog:db",
    "catalog:db": "tsx scripts/ingest-catalog.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "postgres": "^3.4.7",
    "next": "^15.5.3",
    "pixi.js": "^8.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
